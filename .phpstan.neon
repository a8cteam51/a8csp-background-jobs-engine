includes:
    - vendor/a8csp/configs/php/quality-assurance/phpstan.dist.neon

parameters:
    level: max
    # The entry file's define()s are invisible to cross-file analysis (symbol discovery does not
    # read define() calls), so level max needs the constants valued here; the template's bare
    # \constant() style only survives at the shared config's lower level.
    bootstrapFiles:
        - %currentWorkingDirectory%/.phpstan-bootstrap.php
    scanDirectories:
        - vendor/wp-plugin/action-scheduler
    scanFiles:
        - %currentWorkingDirectory%/vendor/wp-cli/wp-cli/php/utils.php
    # The included config autodetects the fixed-name root files (functions-bootstrap.php,
    # functions.php, uninstall.php); the entry file's name is per-repo and footprint.php is a root
    # data manifest, so both are listed here, and WPCompat.pluginFile below names the entry file.
    paths:
        - %currentWorkingDirectory%/a8csp-background-jobs-engine.php
        - %currentWorkingDirectory%/footprint.php
        - %currentWorkingDirectory%/portals
        - %currentWorkingDirectory%/tests
    WPCompat:
        # wp-compat's own fallback guesses "{cwd}/{basename(cwd)}.php", which only holds
        # by coincidence when a repo's directory name matches its entry file; declared
        # explicitly so it doesn't depend on that coincidence.
        pluginFile: %currentWorkingDirectory%/a8csp-background-jobs-engine.php
