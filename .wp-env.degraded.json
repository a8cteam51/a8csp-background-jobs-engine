{
  "$schema": "https://schemas.wp.org/trunk/wp-env.schema.json",
  "phpVersion": "8.5",
  "port": 8892,
  "testsEnvironment": false,
  "mappings": {
    "wp-content/plugins/a8csp-background-tasks-engine": "."
  },
  "lifecycleScripts": {
    "afterStart": "wp-env --config .wp-env.degraded.json run cli wp plugin activate a8csp-background-tasks-engine"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_DISPLAY": false,
    "WP_DEBUG_LOG": true,
    "SCRIPT_DEBUG": true
  }
}
