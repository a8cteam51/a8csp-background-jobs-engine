{
  "name": "a8csp-background-tasks",
  "version": "1.0.0",
  "description": "A plugin for handling long-running background tasks in WordPress.",
  "author": {
    "name": "Automattic Special Projects Team",
    "url": "https://wpspecialprojects.wordpress.com"
  },
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress"
  ],
  "homepage": "https://wordpress.org/plugins/a8csp-background-tasks",
  "repository": "https://github.com/a8cteam51/a8csp-background-tasks",
  "bugs": "https://github.com/a8cteam51/a8csp-background-tasks/issues",
  "engines": {
    "node": ">=22.0",
    "npm": ">=10.0"
  },
  "devDependencies": {
    "@wordpress/env": "^10.8.1",
    "@wordpress/scripts": "^30.0.6",
    "npm-run-all": "^4.1.5"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "build": "npm-run-all --sequential build:**",
    "format": "npm-run-all --sequential format:**",
    "lint": "npm-run-all --sequential lint:**",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "lint:readme-md": "wp-scripts lint-md-docs README.md",
    "packages-update": "wp-scripts packages-update --dist-tag=wp-6.7",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "start": "npm-run-all --parallel start:**",
    "selenium:start": "docker container start selenium-chromium",
    "selenium:stop": "docker container stop selenium-chromium",
    "tests:start": "wp-env start && npm run selenium:start",
    "tests:run": "npm run tests:start && npm run tests:run:integration && npm run tests:run:end-to-end",
    "tests:run:integration": "wp-env run tests-wordpress --env-cwd=project composer run-script tests:run:integration",
    "tests:run:end-to-end": "wp-env run tests-wordpress --env-cwd=project composer run-script tests:run:end-to-end",
    "tests:output-wp-path": "npm run wp-env install-path",
    "tests:export-db": "npm run wp-env run tests-cli wp db export project/tests/Support/Data/dump.sql",
    "wp-env:start": "wp-env start",
    "wp-env:update": "wp-env start --update",
    "wp-env:stop": "wp-env stop",
    "wp-env": "wp-env"
  }
}
